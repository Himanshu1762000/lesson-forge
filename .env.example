# Any OpenAI-compatible endpoint works: OpenAI, Groq, OpenRouter, Together, Ollama, LM Studio, a local gateway...
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...

# Model per role. Using a DIFFERENT model for the judge reduces "grading your own homework" bias.
GENERATOR_MODEL=gpt-4.1
JUDGE_MODEL=gpt-4.1-mini
# Optional (default to GENERATOR_MODEL):
# PLANNER_MODEL=
# REVISER_MODEL=
# COACH_MODEL=

# Examples
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   GENERATOR_MODEL=llama3.1:70b
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1
